# Managed auth and database
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="public-anon-key-for-browser"
SUPABASE_SERVICE_ROLE_KEY="server-only-service-role-key"
DATABASE_URL="postgresql://user:password@host:5432/vizloop"

# Code execution sandbox
SANDBOX_API_KEY="server-only-sandbox-key"
SANDBOX_PROVIDER="provider-name"

# Email, analytics, and monitoring
RESEND_API_KEY="server-only-email-key"
POSTHOG_KEY="public-product-analytics-key"
SENTRY_DSN="error-monitoring-dsn"

# Optional AI tutor provider
ANTHROPIC_API_KEY="server-only-ai-key"
AI_TUTOR_MODEL="chosen-model-name"
